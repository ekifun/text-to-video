# Stage 1: Build
FROM golang:1.21 AS builder

WORKDIR /app

# Copy Go module files
COPY text-to-video-api/go.mod text-to-video-api/go.sum ./
RUN go mod tidy

# Copy source code
COPY text-to-video-api .

# Build the consumer binary
RUN CGO_ENABLED=0 GOOS=linux go build -o consumer ./kafka/consumer.go

# Stage 2: Minimal image
FROM alpine:latest

WORKDIR /root/

COPY --from=builder /app/consumer .

ENTRYPOINT ["./consumer"]
